# =================================================================
# TRACE Backend - Variables de Entorno de Ejemplo
# Copia este archivo a 'backend/.env' y completa con tus credenciales.
# NUNCA subas 'backend/.env' a Git ni expongas claves en repositorios.
# =================================================================

# Configuración del servidor
PORT=8787
ENVIRONMENT=development
LOG_LEVEL=info

# Proveedor de Búsqueda Web (Brave Search API / Tavily / Serper)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Proveedor de Inteligencia Artificial (Gemini API / OpenAI API)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Resolución de Códigos de Barras Adicionales (Opcional: UPCitemdb)
UPCITEMDB_API_KEY=your_upcitemdb_api_key_here

# Seguridad, Rate Limiting y Verificación de Aplicación
RATE_LIMIT_PER_MINUTE=30
ALLOWED_ORIGIN=*
FIREBASE_PROJECT_ID=your_firebase_project_id
PLAY_INTEGRITY_DECRYPTION_KEY=your_integrity_key_here
